# TerraSpectra Root Environment Configuration Template
# ==============================================================================
# Security Policy:
# 1. Never commit real credentials, access keys, or private tokens to Git.
# 2. Copy this template to '.env' for local runtime overrides.
# 3. All production credentials should be injected via environment variables
#    or a dedicated secrets manager.
# ==============================================================================

# Hardware Acceleration & PyTorch Execution Device (auto | cpu | cuda)
# Default is 'auto' which detects CUDA if available, falling back safely to CPU.
TERRASPECTRA_DEVICE=auto

# Random Seed for Reproducibility across NumPy, Python random, and PyTorch
TERRASPECTRA_SEED=42

# Optional: Mapbox Public Access Token (pk.*) for custom geospatial basemap tiles
# If omitted or left as placeholder, TerraSpectra uses token-free CARTO / OSM basemaps.
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Checkpoint & Output Storage Root
TERRASPECTRA_CHECKPOINT_DIR=outputs/checkpoints
