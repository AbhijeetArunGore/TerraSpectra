# TerraSpectra Frontend Environment Configuration
# NOTE: Variables prefixed with VITE_ are bundled into the client-side JavaScript.
# They are visible to any browser user and should NEVER contain secret/private API keys.
# Only use public, domain-restricted tokens.

# Optional: Mapbox Access Token (pk.*)
# If provided, the base map can load custom Mapbox styles (e.g., mapbox://styles/mapbox/dark-v11).
# If left empty, TerraSpectra will automatically use the open, token-free CARTO Dark Matter basemap.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Optional: Custom Basemap Style URL (Carto, Mapbox, or Demotiles GL Style JSON)
# Default fallback: https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_BASEMAP_STYLE_URL=
